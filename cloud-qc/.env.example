# Copy to .env.local and fill in. Never commit real values — this repo is public.

# --- Database (Supabase) ---
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# --- Auth.js ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"

# --- Email (Resend) ---
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="Cloud QC <cloud@youngmuslims.com>"

# --- Scheduled jobs ---
CRON_SECRET=""

# --- File uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- SMS (Twilio) -----------------------------------------------------------
# The Account SID is an identifier, not a secret, but keep it out of the repo
# anyway so there's one place real values live.
TWILIO_ACCOUNT_SID=""
# SECRET. Set this in Vercel (Project > Settings > Environment Variables) or
# via `vercel env add TWILIO_AUTH_TOKEN production`. Never paste it into a
# chat, a commit, an issue or a screenshot — it is a full credential for the
# account and can be used to send messages and spend money. If it is ever
# exposed, rotate it from the Twilio console immediately.
TWILIO_AUTH_TOKEN=""
# The Messaging Service the A2P campaign is attached to (starts MG...).
# Preferred over a bare from-number: the service handles sender selection,
# and STOP/HELP are managed at the service level.
TWILIO_MESSAGING_SERVICE_SID=""

# Set to "true" to let coordinator notifications (email + text) actually
# send. Also requires VERCEL_ENV=production, so local runs never notify a
# real coordinator even though they share the production database.
COORDINATOR_EMAILS_ENABLED=""
