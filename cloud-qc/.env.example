# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase Postgres ---
# From Supabase dashboard > Project Settings > Database > Connection string.
# DATABASE_URL: "Transaction" pooler, port 6543. Add ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   "Session" pooler (or direct), port 5432. Used for migrations.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"
# Optional in dev (trustHost auto-detects). Set to the deployed origin in production.
# AUTH_URL="https://cloud-qc.example.com"

# --- Google OAuth ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: restrict Google sign-in to one Google Workspace domain (enforced
# server-side in the signIn callback). Leave blank to allow any Google account.
GOOGLE_HOSTED_DOMAIN="youngmuslims.com"

# --- Vercel Blob (profile photo uploads) ---
# Vercel dashboard > Storage > Create Database > Blob. Without this set,
# uploading a profile photo returns a friendly error instead of crashing —
# every other profile field still saves fine.
BLOB_READ_WRITE_TOKEN=""

# --- Resend (digest emails) ---
# resend.com dashboard > API Keys. The "from" domain must be added + DNS
# (SPF/DKIM) verified under Domains before sends from it will succeed —
# until then, sends fail loudly rather than silently no-op.
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="Cloud QC <digest@your-verified-domain.com>"
# Absolute origin used for the "Open Cloud QC dashboard" link in digest
# emails. https://cloud-qc.vercel.app in prod; localhost is fine for dev.
APP_URL="http://localhost:3000"
# Any random string — shared secret so only Vercel Cron (or you, manually)
# can trigger /api/cron/digest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# --- App bootstrap ---
# This email is promoted to ADMIN + APPROVED by `npm run db:seed`.
SEED_ADMIN_EMAIL="karimsalem9000@gmail.com"
SEED_ADMIN_NAME="Admin"
# Optional: password for the seeded admin so you can log in without Google.
SEED_ADMIN_PASSWORD=""

# Email coordinators when QC feedback lands for their neighbornet. Off unless
# set to "true" — and only ever sends from the production deployment.
# COORDINATOR_EMAILS_ENABLED="true"
