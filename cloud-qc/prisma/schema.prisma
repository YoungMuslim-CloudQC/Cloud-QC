// Cloud QC — database schema
// Rebuild of the cloud-qc prototype. See ../../cloud-qc (3).html for the original.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled connection (port 6543)
  directUrl = env("DIRECT_URL") // Supabase direct/session connection (port 5432) — used for migrations
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// The account-level role. Deliberately only these two: the coordinator-side
// roles are *assignments* (a person can hold several, each with its own
// scope), so they live in UserRoleAssignment rather than here. See RoleType.
enum Role {
  MEMBER
  ADMIN
  /// DEPRECATED — superseded by UserRoleAssignment. Nothing in this codebase
  /// reads or writes it any more, but the value stays until the release that
  /// removes it has shipped: the currently deployed build still filters on
  /// `role != COORDINATOR`, and dropping the label out from under it took
  /// /feedback and /team down once already. Drop it in a follow-up migration
  /// once this branch is live.
  COORDINATOR
}

// The coordinator-side roles. All three are view-only: holding any of them
// means the account can read feedback but never submit, edit or send it.
enum RoleType {
  // Runs one neighbornet. Full detail on that NN, nothing outside it.
  COORDINATOR
  // Runs a sub-region. Full detail on every NN inside it, plus a national
  // rollup (status + averaged ratings, never the written feedback) of every
  // NN elsewhere.
  SR_COORDINATOR
  // On a coordinator's or SRC's core team: sees exactly what the person who
  // invited them sees, no more. Resolved by walking inheritsFromUserId.
  CORE_TEAM
}

// What someone asked to be at signup. A request the admin rules on during
// the existing PENDING -> APPROVED review, never a grant in itself.
// SR_COORDINATOR is deliberately absent: admin-assigned only, after the fact.
enum RequestedRole {
  MEMBER
  COORDINATOR
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VisitStatus {
  ON_TRACK
  NEEDS_FOLLOWUP
  URGENT
}

// What kind of feedback a Visit row is. BASH / SR_EVENT are inter-sub-region
// gatherings — labeled so their feedback can be routed back to sub-regions.
enum VisitEventType {
  VISIT
  BASH
  SR_EVENT
}

// ACTIVE = a full, established neighbornet. EXPANSION = an SR still in
// training — same table, same queries; see Neighbornet.stage.
enum NeighbornetStage {
  ACTIVE
  EXPANSION
}

enum SiteFeedbackStatus {
  NEW
  RESOLVED
}

enum ParticipantRole {
  SUBMITTER
  CO_VISITOR
}

enum VisitDisputeStatus {
  PENDING
  RESOLVED
}

enum VisitHistoryAction {
  CREATED
  EDITED
  DELETED
  RESTORED
}

// Digest sending itself (email/SMS) is a later pass — these fields only
// capture what a user has asked for.
enum DigestCadence {
  OFF
  WEEKLY
  BIWEEKLY
  MONTHLY
  // Every three months — the cadence coordinators asked for, so a neighbornet
  // gets one "here's the term you just had" summary rather than a drip.
  TRIMESTER
}

enum NotificationChannel {
  EMAIL
  SMS
  BOTH
}

// ---------------------------------------------------------------------------
// Auth & people
// Prototype had separate `users` and `members`; here an approved User *is* a
// Cloud team member.
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  name          String?
  image         String? // OAuth avatar URL, or a Vercel Blob URL once the user uploads their own photo
  passwordHash  String? // null for OAuth-only accounts
  role          Role          @default(MEMBER)
  status        AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // --- Profile / preferences (self-service, set from /profile) ---
  phone               String?
  theme               String?             @default("default")
  digestCadence       DigestCadence       @default(OFF)
  notificationChannel NotificationChannel @default(EMAIL)
  smsConsent          Boolean             @default(false)
  smsConsentAt        DateTime?
  lastDigestSentAt    DateTime? // when their most recent digest email actually went out

  // "Where I'm from" — matches Neighbornet.region/subArea's shape (not a FK;
  // a home base, not a specific neighbornet). Setting/changing this also
  // adds subArea to digestSubAreas as its default (see updateProfile).
  homeRegion     String?
  homeSubArea    String?
  // Which Neighbornet.subArea values this user's digest covers. Empty means
  // "no region picked yet" — buildDigestContent shows a nudge to set one
  // rather than defaulting to everything.
  digestSubAreas String[] @default([])

  // The one specific neighbornet this user represents on the leaderboard —
  // distinct from homeRegion/homeSubArea above (a broad area, not a FK).
  // Cleared automatically if that neighbornet is ever deleted.
  representingNeighbornetId String?
  representingNeighbornet   Neighbornet? @relation("UserRepresents", fields: [representingNeighbornetId], references: [id], onDelete: SetNull)

  // What they asked to be at signup, and (for a coordinator request) which
  // neighbornet they claimed. Both are hints for the admin reviewing their
  // PENDING account — the real grant is a UserRoleAssignment.
  requestedRole          RequestedRole?
  requestedNeighbornetId String?

  // The newest release note this person has seen. Compared against the
  // latest id in lib/changelog.ts to decide whether to pop "what's new" —
  // stored per user rather than in localStorage so it follows them across
  // devices and can't be lost by clearing site data.
  lastSeenChangelog String?

  // Email me as soon as QC logs feedback about a neighbornet I look after,
  // separately from the periodic digest above. Only ever consulted for
  // someone holding a coordinator-side seat.
  alertOnNewFeedback Boolean @default(true)

  roleAssignments        UserRoleAssignment[]     @relation("RoleAssignmentUser")
  coreTeamOf             UserRoleAssignment[]     @relation("RoleAssignmentInheritsFrom")
  roleAssignmentsGranted UserRoleAssignment[]     @relation("RoleAssignmentGrantedBy")
  visitReviews           CoordinatorVisitReview[]
  legacyCoordinates      NeighbornetCoordinator[]

  accounts             Account[]
  sessions             Session[]
  submittedVisits      Visit[]              @relation("VisitSubmittedBy")
  participations       VisitParticipant[]
  comments             VisitComment[]
  visitHistoryEntries  VisitHistory[]
  disputesAgainstMe    VisitDispute[]       @relation("DisputedUser")
  disputesResolved     VisitDispute[]       @relation("DisputeResolvedBy")
  siteFeedback         SiteFeedback[]
  rotations            RotationAssignment[] @relation("RotationUser")
  rotationsAssigned    RotationAssignment[] @relation("RotationAssignedBy")
  neighbornetsCreated  Neighbornet[]        @relation("NeighbornetCreatedBy")
  neighbornetsArchived Neighbornet[]        @relation("NeighbornetArchivedBy")

  @@index([status])
  @@index([representingNeighbornetId])
}

// Auth.js standard adapter model
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js standard adapter model — retained for adapter compatibility even
// though the app uses the JWT session strategy (required to mix Credentials +
// OAuth providers).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Neighbornets
// ---------------------------------------------------------------------------

model Neighbornet {
  id           String    @id @default(cuid())
  name         String
  city         String?
  region       String
  subArea      String?
  stateCode    String?   @db.Char(2) // always set on create/update; legacy rows may be null
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  contactEmail String?
  instagram    String?
  archivedAt   DateTime? // set together with archivedById; both cleared on unarchive
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // A full NN and an early-stage "expansion" (an SR still in training, not
  // yet QC'd) share this same table and every query that lists NNs — the
  // stage is purely a label + filter (see /neighbornets), not an access
  // gate. An expansion can still be visited, logged, coordinated, etc.
  // exactly like an ACTIVE one; nothing reads this field to hide a row.
  stage NeighbornetStage @default(ACTIVE)

  // Set only while tracking an expansion's social media rollout; meaningless
  // for an ACTIVE NN but left on the same row rather than a second table so
  // a promoted expansion keeps its id/history with nothing to migrate.
  mediaLead           String?
  phone               String?
  driveUploads        Boolean?
  postingConsistently Boolean?
  expansionComments   String?

  createdById String?
  createdBy   User?   @relation("NeighbornetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  archivedById String?
  archivedBy   User?   @relation("NeighbornetArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  visits             Visit[] // legacy single-NN pointer — see Visit.neighbornetId
  visitLinks         VisitNeighbornet[] // the real, credit-bearing visit <-> NN link
  rotations          RotationAssignment[]
  representedBy      User[]                   @relation("UserRepresents")
  roleAssignments    UserRoleAssignment[]
  legacyCoordinators NeighbornetCoordinator[]

  @@index([stateCode])
  @@index([region, subArea])
  @@index([archivedAt])
}

// One held coordinator-side role. A person can hold several rows here (a
// core-team seat and a coordinator seat, say), which is why this isn't a
// field on User. Exactly one scope column is set per row, decided by
// roleType — see RoleType for which.
model UserRoleAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleType RoleType

  userId String
  user   User   @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  // COORDINATOR: the one neighbornet they run. A person holds at most one
  // COORDINATOR row (enforced in code, not by a constraint, because the
  // succession window deliberately puts *two people* on one neighbornet).
  scopeNeighbornetId String?
  scopeNeighbornet   Neighbornet? @relation(fields: [scopeNeighbornetId], references: [id], onDelete: Cascade)

  // SR_COORDINATOR: the sub-region they run. Same string vocabulary as
  // Neighbornet.subArea — not a foreign key, exactly like Visit.subRegion.
  scopeSubregion String?

  // CORE_TEAM: whose visibility this seat borrows. Resolved by walking up
  // until a non-CORE_TEAM assignment is found, so a chain still lands on a
  // real scope (and so an outgoing coordinator's core team keeps working
  // after the handoff re-seats them under the new coordinator).
  inheritsFromUserId String?
  inheritsFrom       User?   @relation("RoleAssignmentInheritsFrom", fields: [inheritsFromUserId], references: [id], onDelete: Cascade)

  // Set on the OUTGOING coordinator's row when a handoff starts: both hold
  // the neighbornet until this passes, then the nightly cron retires this
  // row and re-seats them on the new coordinator's core team.
  transitionEndsAt DateTime?

  grantedById String?
  grantedBy   User?   @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleType])
  @@index([scopeNeighbornetId])
  @@index([scopeSubregion])
  @@index([inheritsFromUserId])
  @@index([transitionEndsAt])
}

/// DEPRECATED — superseded by UserRoleAssignment (roleType COORDINATOR).
/// Unused by this codebase and always empty; kept only so the schema matches
/// the database the currently deployed build still queries. Dropped in a
/// follow-up migration once this branch has shipped.
model NeighbornetCoordinator {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  neighbornetId String
  neighbornet   Neighbornet @relation(fields: [neighbornetId], references: [id], onDelete: Cascade)

  @@unique([userId, neighbornetId])
  @@index([neighbornetId])
}

// "I've read this one." Per person rather than per neighbornet: a
// coordinator and each of their core team work through the inbox on their
// own, so one of them clearing a visit must not clear it for the others.
model CoordinatorVisitReview {
  id         String   @id @default(cuid())
  reviewedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([userId, visitId])
  @@index([userId])
  @@index([visitId])
}

// Feedback about the Cloud QC site itself, left from any page: the person
// highlights part of the screen and says what's wrong / how to improve it.
model SiteFeedback {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  status     SiteFeedbackStatus @default(NEW)
  resolvedAt DateTime?

  path       String // pathname + query of the page it was left on
  problem    String // what's wrong
  suggestion String? // how it could improve
  // Where on the page: { selector, text, rect:{x,y,w,h} (document px),
  // viewport:{w,h}, scrollY, userAgent, theme }.
  context    Json?
  // JPEG data URL of the highlighted area. Best-effort — absent if the
  // capture failed. Served by /admin/site-feedback/<id>/screenshot.
  screenshot String? @db.Text

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Visits (prototype: "feedback")
// ---------------------------------------------------------------------------

model Visit {
  id               String       @id @default(cuid())
  visitDate        DateTime     @db.Date
  groupSize        Int? // prototype "average group size"
  avgAge           Int?
  // Cached aggregate, not raw input beyond the submitter's own first entry:
  // worst status / averaged ratings across every participant who contributed
  // their own assessment (see VisitParticipant.status/*Rating). Recomputed
  // by recomputeVisitAggregates() whenever a participant confirms with their
  // own ratings — every existing reader of these four fields keeps working
  // unchanged, they just now reflect the roll-up instead of one person's input.
  foodRating       Int?         @db.SmallInt // 1–5
  leadershipRating Int?         @db.SmallInt
  halaqahRating    Int?         @db.SmallInt
  status           VisitStatus?
  notes            String // required
  feedbackSent     Boolean      @default(false)
  deletedAt        DateTime? // soft delete — excluded everywhere by default
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Legacy — superseded by jointEventId fan-out being replaced with one Visit
  // row + multiple VisitNeighbornet links. Left populated on old rows only;
  // no longer written.
  jointEventId String?

  eventType               VisitEventType @default(VISIT)
  // Set only for BASH / SR_EVENT: which sub-region the event was for (same
  // string vocabulary as Neighbornet.region/subArea — not a FK).
  subRegion               String?
  // BASH / SR_EVENT only: neighbornets that were involved, for visibility on
  // this visit alone — deliberately NOT a relation. Never read by any NN
  // status/history/leaderboard query; see VisitNeighbornet for the link that
  // actually counts.
  mentionedNeighbornetIds String[]       @default([])

  // Legacy single-NN pointer — kept for old rows and as a convenience, but no
  // longer the source of truth for which NN(s) a visit counts toward; see
  // VisitNeighbornet. Null for BASH/SR_EVENT and for any visit created after
  // this field stopped being written.
  neighbornetId String?
  neighbornet   Neighbornet? @relation(fields: [neighbornetId], references: [id], onDelete: SetNull)

  // The real, credit-bearing link(s) — one row per NN this visit counts
  // toward. A joint event across N neighbornets is one Visit with N of these,
  // not N Visit rows: this is what makes "1 visit = at most 1 point" hold
  // regardless of how many NNs it's tagged to.
  neighbornets VisitNeighbornet[]

  submittedById String
  submittedBy   User   @relation("VisitSubmittedBy", fields: [submittedById], references: [id])

  participants       VisitParticipant[]
  comments           VisitComment[]
  history            VisitHistory[]
  disputes           VisitDispute[]           @relation("DisputedVisit")
  ownedDisputes      VisitDispute[]           @relation("DisputeOwnVisit")
  coordinatorReviews CoordinatorVisitReview[]

  @@index([neighbornetId, visitDate])
  @@index([submittedById])
  @@index([deletedAt])
  @@index([jointEventId])
}

// The credit-bearing visit <-> neighbornet link. A plain single-NN visit has
// exactly one row here; a joint event has one row per tagged NN. Every NN
// status/history rollup reads through this table, never Visit.neighbornetId.
model VisitNeighbornet {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  neighbornetId String
  neighbornet   Neighbornet @relation(fields: [neighbornetId], references: [id], onDelete: Cascade)

  @@unique([visitId, neighbornetId])
  @@index([neighbornetId])
}

// Flagged when a named participant denies having been at a visit (same NN(s)
// + date matched, but they said "no" to "did you visit with X?"). Sits in an
// admin review queue at /admin/visit-disputes until resolved.
model VisitDispute {
  id         String             @id @default(cuid())
  status     VisitDisputeStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?
  note       String?
  notifiedAt DateTime? // when the original submitter was emailed about this

  // The original visit — the one whose participant list is in question.
  visitId String
  visit   Visit  @relation("DisputedVisit", fields: [visitId], references: [id], onDelete: Cascade)

  // The user who denied being a participant.
  disputedUserId String
  disputedUser   User   @relation("DisputedUser", fields: [disputedUserId], references: [id], onDelete: Cascade)

  // Their own separate visit, logged instead — for the admin to compare
  // side by side. Kept even if later deleted (SetNull, not cascaded).
  ownVisitId String?
  ownVisit   Visit?  @relation("DisputeOwnVisit", fields: [ownVisitId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([disputedUserId])
}

// Append-only audit log — one row per create / edit / delete / restore of a
// visit, with a full JSON snapshot of the visit's state at that moment.
model VisitHistory {
  id          String             @id @default(cuid())
  action      VisitHistoryAction
  snapshot    Json
  performedAt DateTime           @default(now())

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  @@index([visitId, performedAt])
}

// Replaces the prototype's `submittedBy` string + `coVisitors` array.
// Every visit gets one SUBMITTER row; co-visitors get CO_VISITOR rows.
// "Visits logged" = count of these rows + app_settings.manual_visit_offset.
model VisitParticipant {
  id          String          @id @default(cuid())
  role        ParticipantRole
  // Personally filled in their own assessment — the submitter always has,
  // true; a co-visitor only does if they confirmed with their own ratings
  // rather than just being named. Gates whether the four fields below are
  // set, and whether this row counts toward Visit's recomputed aggregate.
  contributed Boolean         @default(false)
  createdAt   DateTime        @default(now())

  // This participant's own rating of the visit — null unless contributed.
  // Visit.status/*Rating are the roll-up across every contributing row.
  status           VisitStatus?
  foodRating       Int?         @db.SmallInt
  leadershipRating Int?         @db.SmallInt
  halaqahRating    Int?         @db.SmallInt

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitId, userId])
  @@index([userId])
}

// Replaces the prototype's practice of string-appending merged notes.
model VisitComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([visitId])
}

// ---------------------------------------------------------------------------
// Rotation (prototype: `partners` map + `rotationHistory` snapshots)
// Current pairing = rows where endedOn IS NULL. History = all rows.
// ---------------------------------------------------------------------------

model RotationAssignment {
  id        String    @id @default(cuid())
  startedOn DateTime  @default(now()) @db.Date
  endedOn   DateTime? @db.Date

  neighbornetId String
  neighbornet   Neighbornet @relation(fields: [neighbornetId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("RotationUser", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("RotationAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([neighbornetId, endedOn])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// App settings — key/value singleton store
// Keys: "manual_visit_offset" (number), "visit_goal" (number | null)
// ---------------------------------------------------------------------------

model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}
